# Copy to server/.env for local runs. Never commit real values.

# Anthropic key. The server also reads SPARK_ANTHROPIC_API_KEY (the cloud
# environment's name for it) when this one is unset.
ANTHROPIC_API_KEY=

# KIE (kie.ai) key for npm run assets:gen. Leave blank in the cloud: the network
# proxy adds it to requests to api.kie.ai. Missing key = placeholder art.
KIE_API_KEY=

# The server always calls https://api.anthropic.com and ignores ANTHROPIC_BASE_URL.

# Models (docs/SPEC.md §12). All four IDs were verified with a 10-token call.
MODEL_EXTRACTOR=claude-opus-5-5
MODEL_EXAMINER=claude-opus-5-5
MODEL_CREATURE=claude-haiku-5-5
MODEL_BARS=claude-haiku-5-5

# 1 = every AI route answers from demo/ fixtures (offline mode).
AI_STUB=0

# Server port (the extension expects 8787).
PORT=8787

# Non-secret token the extension sends in the X-Spark header (default in shared/config.ts).
SPARK_CLIENT_TOKEN=spark-oslo-2026
