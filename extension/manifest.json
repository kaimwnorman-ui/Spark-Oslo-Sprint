{
  "manifest_version": 3,
  "name": "Spark",
  "short_name": "Spark",
  "description": "Turn any page into a monster made of its words. Beat it by teaching Blot the five ideas that matter.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Spark: turn this page into a monster",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["http://localhost:8787/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Turn this page into a monster"
    }
  }
}
